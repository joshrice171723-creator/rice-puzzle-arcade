EXPO_PUBLIC_ADS_MODE=test
EXPO_PUBLIC_BUILD_PROFILE=internal
# Per-game production App IDs and ad units: packages/ads/publisher.json
# Do not share one app ID across games. Legacy overrides must match that mapping.
PUBLISHER_RELEASE_APPROVED=false

# Studio collector; production installs require analytics opt-in in Privacy & support.
EXPO_PUBLIC_ANALYTICS_URL=https://aimetaclinic.com/games/api/events
